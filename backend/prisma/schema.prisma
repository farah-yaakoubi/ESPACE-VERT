generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
// NOUVEAU
enum NotifType {
  nouveau_devis
  nouveau_rdv
  nouveau_message
  @@map("notif_type")
}

enum DevisStatut {
  nouveau
  en_cours
  traite
  rejete
  @@map("devis_statut")
}

enum RdvStatut {
  nouveau
  confirme
  annule
  termine
  @@map("rdv_statut")
}

enum Division {
  standard
  pro
  garden
  @@map("division")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────
model Role {
  id_role     Int     @id @default(autoincrement())
  nom         String  @unique @db.VarChar(80)
  permissions Json    @default("[]")
  admins      Admin[]
  @@map("roles")
}

model Admin {
  id_admin     Int      @id @default(autoincrement())
  nom          String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  mot_de_passe String   @db.VarChar(255)
  actif        Boolean  @default(true)
  id_role      Int      @default(2)
  avatar       String?  @db.VarChar(500)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  role              Role             @relation(fields: [id_role], references: [id_role])
  actualites        Actualite[]
  devis_traites     DevisDemande[]
  rdv_confirmes     RendezVous[]
  messages_rep      ContactMessage[]
  audit_logs        AuditLog[]
  sessions          SessionAdmin[]
  notifs_recues     AdminNotification[] @relation("NotifDestinataire")
  messages_envoyes  ChatMessage[]       @relation("ChatEmetteur")
  messages_recus    ChatMessage[]       @relation("ChatRecepteur")
  @@index([id_role])
  @@map("admins")
}

// ─── NOTIFICATIONS ADMIN ──────────────────────────────────────────────────────
model AdminNotification {
  id_notif   Int       @id @default(autoincrement())
  id_admin   Int
  type       NotifType
  titre      String    @db.VarChar(200)
  corps      String?   @db.VarChar(500)
  lien       String?   @db.VarChar(300)
  lu         Boolean   @default(false)
  created_at DateTime  @default(now())
  admin Admin @relation("NotifDestinataire", fields: [id_admin], references: [id_admin], onDelete: Cascade)
  @@index([id_admin, lu])
  @@index([created_at])
  @@map("admin_notifications")
}

// ─── CHAT INTER-ADMINS ────────────────────────────────────────────────────────
model ChatMessage {
  id_msg     Int      @id @default(autoincrement())
  id_from    Int
  id_to      Int
  contenu    String   @db.Text
  lu         Boolean  @default(false)
  created_at DateTime @default(now())
  emetteur  Admin @relation("ChatEmetteur",  fields: [id_from], references: [id_admin], onDelete: Cascade)
  recepteur Admin @relation("ChatRecepteur", fields: [id_to],   references: [id_admin], onDelete: Cascade)
  @@index([id_from, id_to])
  @@index([id_to, lu])
  @@index([created_at])
  @@map("chat_messages")
}

model SessionAdmin {
  id_session    Int      @id @default(autoincrement())
  id_admin      Int
  refresh_token String   @db.VarChar(512)
  ip_address    String?  @db.VarChar(45)
  user_agent    String?  @db.Text
  expires_at    DateTime
  created_at    DateTime @default(now())
  admin Admin @relation(fields: [id_admin], references: [id_admin], onDelete: Cascade)
  @@index([id_admin])
  @@map("sessions_admin")
}

// ─── VISITEUR ─────────────────────────────────────────────────────────────────
model Visiteur {
  id_visiteur    Int      @id @default(autoincrement())
  token_visiteur String   @unique @db.VarChar(128)
  ip_address     String   @db.VarChar(45)
  user_agent     String?  @db.Text
  pays           String?  @db.VarChar(80)
  region         String?  @db.VarChar(120)
  device_type    String?  @db.VarChar(20)
  browser        String?  @db.VarChar(60)
  os             String?  @db.VarChar(60)
  first_visit    DateTime @default(now())
  last_visit     DateTime @updatedAt
  visites_pages  VisitePage[]
  search_queries SearchQuery[]
  devis          DevisDemande[]
  rendez_vous    RendezVous[]
  messages       ContactMessage[]
  @@map("visiteurs")
}

model VisitePage {
  id_vp       Int      @id @default(autoincrement())
  id_visiteur Int
  url         String   @db.VarChar(500)
  titre       String?  @db.VarChar(255)
  duree       Int      @default(0)
  id_produit  Int?
  visited_at  DateTime @default(now())
  visiteur Visiteur @relation(fields: [id_visiteur], references: [id_visiteur], onDelete: Cascade)
  produit  Produit? @relation(fields: [id_produit], references: [id_produit], onDelete: SetNull)
  @@index([id_visiteur])
  @@index([visited_at])
  @@index([id_produit])
  @@map("visites_pages")
}

model SearchQuery {
  id_search   Int      @id @default(autoincrement())
  id_visiteur Int
  query       String   @db.VarChar(500)
  nb_results  Int      @default(0)
  searched_at DateTime @default(now())
  visiteur Visiteur @relation(fields: [id_visiteur], references: [id_visiteur], onDelete: Cascade)
  @@index([id_visiteur])
  @@index([searched_at])
  @@map("search_queries")
}

// ─── CATALOGUE ────────────────────────────────────────────────────────────────
model Marque {
  id_marque   Int         @id @default(autoincrement())
  nom         String      @db.VarChar(120)
  logo        String?     @db.VarChar(500)
  description String?     @db.Text
  slug        String      @unique @db.VarChar(160)
  actif       Boolean     @default(true)
  created_at  DateTime    @default(now())
  categories  Categorie[]
  produits    Produit[]
  @@map("marques")
}

model Activite {
  id_activite Int         @id @default(autoincrement())
  nom         String      @db.VarChar(150)
  description String?     @db.Text
  image       String?     @db.VarChar(500)
  slug        String      @unique @db.VarChar(180)
  ordre       Int         @default(0)
  actif       Boolean     @default(true)
  created_at  DateTime    @default(now())
  categories  Categorie[]
  produits    Produit[]
  @@map("activites")
}

model Categorie {
  id_categorie Int      @id @default(autoincrement())
  nom          String   @db.VarChar(150)
  description  String?  @db.Text
  image        String?  @db.VarChar(500)
  slug         String   @unique @db.VarChar(180)
  // ← Une catégorie peut appartenir à une marque ET/OU une activité
  id_activite  Int?
  id_marque    Int?
  parent_id    Int?
  ordre        Int      @default(0)
  actif        Boolean  @default(true)
  created_at   DateTime @default(now())
  activite  Activite?   @relation(fields: [id_activite], references: [id_activite], onDelete: SetNull)
  marque    Marque?     @relation(fields: [id_marque],   references: [id_marque],   onDelete: SetNull)
  parent    Categorie?  @relation("SousCategories", fields: [parent_id], references: [id_categorie], onDelete: Cascade)
  sous_cats Categorie[] @relation("SousCategories")
  produits  Produit[]
  @@index([id_activite])
  @@index([id_marque])
  @@index([parent_id])
  @@map("categories")
}

model Produit {
  id_produit           Int      @id @default(autoincrement())
  nom                  String   @db.VarChar(200)
  description          String?  @db.Text
  fiche_technique      String?  @db.Text
  slug                 String   @unique @db.VarChar(220)
  id_categorie         Int
  id_marque            Int?     // ← optionnel : un produit peut n'appartenir qu'à une activité
  id_activite          Int?     // ← lien direct optionnel avec activité
  division             Division @default(standard)
  tags                 Json?    @default("[]")
  actif                Boolean  @default(true)
  ordre                Int      @default(0)
  // ── Champs techniques ──────────────────────────────────────────
  sku                  String?  @db.VarChar(100)
  poids                String?  @db.VarChar(50)
  nature               String?  @db.VarChar(100)
  composition_chimique String?  @db.Text
  usage                String?  @db.Text
  biologique           Boolean? @default(false)
  conditionnement      String?  @db.VarChar(200)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  categorie Categorie @relation(fields: [id_categorie], references: [id_categorie], onDelete: Restrict, onUpdate: Cascade)
  marque    Marque?   @relation(fields: [id_marque],    references: [id_marque])
  activite  Activite? @relation(fields: [id_activite],  references: [id_activite], onDelete: SetNull)
  images    ProduitImage[]
  devis     DevisDemande[]
  visites   VisitePage[]
  @@index([id_categorie])
  @@index([id_marque])
  @@index([id_activite])
  @@index([actif])
  @@map("produits")
}

model ProduitImage {
  id_imgP       Int     @id @default(autoincrement())
  id_produit    Int
  url           String  @db.VarChar(500)
  alt           String? @db.VarChar(255)
  ordre         Int     @default(0)
  is_principale Boolean @default(false)
  conditionnement String? @db.VarChar(200)
  produit Produit @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)
  @@index([id_produit])
  @@map("produits_images")
}

// ─── CONTENU ÉDITORIAL ────────────────────────────────────────────────────────
model Actualite {
  id_actualite Int       @id @default(autoincrement())
  titre        String    @db.VarChar(255)
  contenu      String    @db.LongText
  image        String?   @db.VarChar(500)
  slug         String    @unique @db.VarChar(280)
  publiee      Boolean   @default(false)
  published_at DateTime?
  id_admin     Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  admin Admin? @relation(fields: [id_admin], references: [id_admin], onDelete: SetNull)
  @@index([publiee])
  @@map("actualites")
}

model Faq {
  id_faq           Int      @id @default(autoincrement())
  question         String   @db.Text
  reponse          String   @db.Text
  categorie        String?  @db.VarChar(120)
  ordre            Int      @default(0)
  active           Boolean  @default(true)
  nb_consultations Int      @default(0)
  created_at       DateTime @default(now())
  @@index([active])
  @@map("faqs")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────
model DevisDemande {
  id_devis      Int         @id @default(autoincrement())
  nom           String      @db.VarChar(150)
  email         String      @db.VarChar(180)
  telephone     String?     @db.VarChar(30)
  message       String?     @db.Text
  reponse_admin String?     @db.Text
  statut        DevisStatut @default(nouveau)
  id_produit    Int?
  id_visiteur   Int?
  id_admin      Int?
  note_interne  String?     @db.Text
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  produit  Produit?  @relation(fields: [id_produit],  references: [id_produit],  onDelete: SetNull)
  visiteur Visiteur? @relation(fields: [id_visiteur], references: [id_visiteur], onDelete: SetNull)
  admin    Admin?    @relation(fields: [id_admin],    references: [id_admin],    onDelete: SetNull)
  @@index([statut])
  @@index([id_admin])
  @@map("devis_demandes")
}

model RendezVous {
  id_rdv         Int       @id @default(autoincrement())
  nom            String    @db.VarChar(150)
  email          String    @db.VarChar(180)
  telephone      String?   @db.VarChar(30)
  date_souhaitee DateTime  @db.Date
  heure          String?   @db.VarChar(10)
  objet          String?   @db.VarChar(255)
  agence         String?   @db.VarChar(120)
  message        String?   @db.Text
  statut         RdvStatut @default(nouveau)
  id_visiteur    Int?
  id_admin       Int?
  note_interne   String?   @db.Text
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  visiteur Visiteur? @relation(fields: [id_visiteur], references: [id_visiteur], onDelete: SetNull)
  admin    Admin?    @relation(fields: [id_admin],    references: [id_admin],    onDelete: SetNull)
  @@index([statut])
  @@index([date_souhaitee])
  @@map("rendez_vous")
}

model ContactMessage {
  id_contact  Int       @id @default(autoincrement())
  nom         String    @db.VarChar(150)
  email       String    @db.VarChar(180)
  sujet       String?   @db.VarChar(255)
  message     String    @db.Text
  reponse     String?   @db.Text
  lu          Boolean   @default(false)
  id_visiteur Int?
  id_admin    Int?
  created_at  DateTime  @default(now())
  replied_at  DateTime?
  visiteur Visiteur? @relation(fields: [id_visiteur], references: [id_visiteur], onDelete: SetNull)
  admin    Admin?    @relation(fields: [id_admin],    references: [id_admin],    onDelete: SetNull)
  @@index([lu])
  @@map("contact_messages")
}

// ─── TRAÇABILITÉ ──────────────────────────────────────────────────────────────
model AuditLog {
  id_log      Int      @id @default(autoincrement())
  id_admin    Int?
  action      String   @db.VarChar(100)
  entity_name String   @db.VarChar(80)
  entity_id   Int?
  detail      Json?
  ip_address  String?  @db.VarChar(45)
  date_action DateTime @default(now())
  admin Admin? @relation(fields: [id_admin], references: [id_admin], onDelete: SetNull)
  @@index([id_admin])
  @@index([entity_name])
  @@index([date_action])
  @@map("audit_logs")
}
